{
  "manifest_version": 3,
  "name": "Bookmarks Bar Menu",
  "version": "1.0.0",
  "description": "Chrome-style bookmarks bar menu with context actions and drag reorder.",
  "permissions": ["bookmarks", "tabs", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Bookmarks Bar",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
