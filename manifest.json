{
  "manifest_version": 3,
  "name": "Flymarks",
  "version": "1.0.1",
  "description": "Fast Chrome bookmarks popup with context actions and drag reorder.",
  "permissions": ["bookmarks", "storage", "favicon"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Flymarks",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
